<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2D234A" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#7054C4" />
            <stroke
                android:width="2dp"
                android:color="#BBA8F5" />
        </shape>
    </item>
</layer-list>
