<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#2D234A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:background="#FFFDF8"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvDialogCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_pill_badge"
                android:text="Ciencia &amp; Naturaleza"
                android:textColor="#2D234A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

            <FrameLayout
                android:id="@+id/btnDialogCloseContainer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_btn_square_close_white">

                <ImageView
                    android:id="@+id/ivDialogClose"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close_clean"
                    app:tint="#6C5CE7"
                    android:contentDescription="Cerrar" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_badge"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivDialogStatusIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_rocket"
                android:contentDescription="Icono de Estado" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvDialogLevelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="NIVEL 1"
            android:textColor="#A09BB0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvDialogLevelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="El Despertar de la Flora"
            android:textColor="@color/ref_text_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDialogLevelDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Fotosíntesis, hojas y secretos del reino vegetal."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:id="@+id/layoutDialogStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivDialogStar1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_star_golden"
                android:contentDescription="Estrella 1" />

            <ImageView
                android:id="@+id/ivDialogStar2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_star_golden"
                android:contentDescription="Estrella 2" />

            <ImageView
                android:id="@+id/ivDialogStar3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_star_golden"
                android:contentDescription="Estrella 3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="5 Preguntas Temáticas • +500 Pts Posibles"
            android:textColor="#A09BB0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogPlayLevel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_pill_coral"
            android:text="@string/dialog_level_play_btn"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
