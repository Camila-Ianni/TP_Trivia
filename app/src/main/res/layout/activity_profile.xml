<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ref_quiz_lavender">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/btnProfileBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_square_back"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#6C5CE7"
                android:contentDescription="Atrás" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/profile_header_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/ivProfileMonster"
                android:layout_width="210dp"
                android:layout_height="145dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"
                android:src="@drawable/img_monster_rosa"
                android:contentDescription="Monstruo Perfil" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="105dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#2D234A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:background="#FFFDF8"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:id="@+id/ivCurrentProfileAvatar"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_avatar_perfil1"
                        android:contentDescription="Avatar" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:boxStrokeColor="#6C5CE7"
                        app:hintTextColor="#6C5CE7">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProfileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_profile_username"
                            android:inputType="text"
                            android:maxLength="20"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxStrokeColor="#6C5CE7"
                        app:hintTextColor="#6C5CE7">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProfileEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_profile_email"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilProfilePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxStrokeColor="#6C5CE7"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#6C5CE7">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProfilePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_profile_password"
                            android:inputType="textPassword"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvPlayerTitleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_score_yellow"
                        android:text="Aventurero"
                        android:textColor="@color/ref_text_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_letter_badge"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvProfileHighScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1560 pts"
                                android:textColor="#6C5CE7"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Récord"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvProfileTotalStars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="#F59E0B"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProfileMaxLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Nivel Máx"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_letter_badge"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvProfileMatchesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#2D234A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_matches_label"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvProfileAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#10B981"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_accuracy_label"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Elige tu avatar"
                        android:textColor="@color/ref_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProfileAvatars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Medallas de Honor"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toca para ver"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardMedal1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivMedal1"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_medalla1"
                                android:contentDescription="Medalla 1" />

                            <TextView
                                android:id="@+id/tvMedal1Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Iniciado"
                                android:textColor="#2D3142"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/tvMedal1Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Bloqueada"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardMedal2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivMedal2"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_medalla2"
                                android:contentDescription="Medalla 2" />

                            <TextView
                                android:id="@+id/tvMedal2Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Sabiduría"
                                android:textColor="#2D3142"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/tvMedal2Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Bloqueada"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardMedal3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivMedal3"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_medalla3"
                                android:contentDescription="Medalla 3" />

                            <TextView
                                android:id="@+id/tvMedal3Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Castillo"
                                android:textColor="#2D3142"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/tvMedal3Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Bloqueada"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_bestiary_title"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_bestiary_hint"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardGuardian1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivGuardian1"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_monster_rosa"
                                android:contentDescription="@string/bestiary_pinki" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/bestiary_pinki"
                                android:textColor="#2D3142"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGuardian1Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardGuardian2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivGuardian2"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_monster_celeste"
                                android:contentDescription="@string/bestiary_bloop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/bestiary_bloop"
                                android:textColor="#2D3142"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGuardian2Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardGuardian3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivGuardian3"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_monster_naranja"
                                android:contentDescription="@string/bestiary_chomp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/bestiary_chomp"
                                android:textColor="#2D3142"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGuardian3Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardGuardian4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_option_letter_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/ivGuardian4"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_monster_violeta"
                                android:contentDescription="@string/bestiary_zook" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/bestiary_zook"
                                android:textColor="#2D3142"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGuardian4Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/profile_preferences_title"
                        android:textColor="@color/ref_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_option_letter_badge"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchSound"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_sound_switch"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVibration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_vibration_switch"
                            android:textColor="@color/ref_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_pill_coral"
                android:text="@string/btn_save_profile"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnManageUsers"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_score_yellow"
                    android:text="@string/btn_manage_users"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnManageQuestions"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_score_white"
                    android:text="@string/btn_manage_questions"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMatchHistory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_score_white"
                android:text="@string/btn_match_history"
                android:textColor="@color/ref_text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_pill_white"
                    android:text="@string/btn_logout"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_pill_white"
                    android:text="@string/btn_delete_account"
                    android:textColor="@color/wrong_red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_unified_bottom_nav" />

</LinearLayout>
