<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutBottomNav"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:background="@drawable/bg_retro_bottom_nav"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/btnNavMap"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavMap"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_discovery"
            app:tint="#A09BB0"
            android:contentDescription="@string/nav_desc_map" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavLeaderboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavLeaderboard"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_trophy"
            app:tint="#A09BB0"
            android:contentDescription="@string/nav_desc_ranking" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavSocial"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavSocial"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_duel"
            app:tint="#A09BB0"
            android:contentDescription="@string/nav_desc_social" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavQuests"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavQuests"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_checklist"
            app:tint="#A09BB0"
            android:contentDescription="@string/quests_title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavQuestions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavQuestions"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_book"
            app:tint="#A09BB0"
            android:contentDescription="@string/nav_desc_questions" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnNavProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavProfile"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_profile"
            app:tint="#A09BB0"
            android:contentDescription="@string/nav_desc_profile" />
    </LinearLayout>
</LinearLayout>
