<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#2D234A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="#FFFDF8"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvQuestionFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qm_dialog_create_title"
                android:textColor="@color/ref_text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/qm_label_level"
                android:textColor="@color/ref_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFormLevel"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_option_letter_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFormCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_category"
                    android:inputType="textCapWords"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFormQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_question"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_option_a"
                    android:inputType="textCapSentences"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_option_b"
                    android:inputType="textCapSentences"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_option_c"
                    android:inputType="textCapSentences"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_option_d"
                    android:inputType="textCapSentences"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/qm_label_correct"
                android:textColor="@color/ref_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCorrectOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOptionA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/qm_radio_a"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbOptionB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/qm_radio_b"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbOptionC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/qm_radio_c"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbOptionD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/qm_radio_d"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="11sp" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="#6C5CE7"
                app:hintTextColor="#6C5CE7">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFormExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/qm_hint_explanation"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFormQuestionCancel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_pill_white"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/ref_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFormQuestionSave"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_pill_coral"
                    android:text="@string/qm_btn_save"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
